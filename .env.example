# ─────────────────────────────────────────────────────────────────────────
# H-EKAM OAT — variables d'environnement
# Toutes les variables sont OPTIONNELLES pour la démonstration frontend :
# une variable absente ne casse ni la homepage ni le configurateur.
# Aucune vraie clé n'est fournie ni requise pour déployer sur Vercel.
# ─────────────────────────────────────────────────────────────────────────

# URL publique du site (SEO, sitemap, Open Graph).
# Sur Vercel, sans cette variable, l'URL du projet est détectée automatiquement.
# Exemple : NEXT_PUBLIC_SITE_URL=https://www.exemple.fr
NEXT_PUBLIC_SITE_URL=

# ── 3D (optionnel) : chemin d'un modèle .glb/.gltf déposé dans /public/models
# Exemple : NEXT_PUBLIC_CAKE_MODEL_URL=/models/cake.glb
NEXT_PUBLIC_CAKE_MODEL_URL=

# ── Phase 5 — NE PAS remplir pour le déploiement frontend ─────────────────
# Supabase (auth, commandes, catalogue dynamique, uploads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (paiement)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
